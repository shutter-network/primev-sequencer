# PrimeV PoC Sequencer Configuration
# Copy this file to .env and update the values for your environment

# RPC server configuration
RPC_PORT=8545
UPSTREAM_RPC_URL=http://localhost:8546
LOG_LEVEL=info

# Required configuration - these must be set
GRPC_ADDR=localhost:13524
KEYPER_SET_MANAGER_ADDRESS=0x1234567890123456789012345678901234567890
KEY_BROADCAST_ADDRESS=0x1234567890123456789012345678901234567890

# P2P configuration
INSTANCE_ID=42
P2P_KEY=your_p2p_private_key_here
P2P_BOOTSTRAP_ADDRESSES=/ip4/127.0.0.1/tcp/23003/p2p/QmExampleBootstrapPeer
P2P_PORT=23003
P2P_ENVIRONMENT=0
P2P_DISCOVERY_NAMESPACE=primev-poc

