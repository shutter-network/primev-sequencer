# PrimeV PoC Sequencer Configuration
# Copy this file to .env and update the values for your environment

# RPC server configuration
RPC_PORT=8545
UPSTREAM_RPC=http://localhost:8546
LOG_LEVEL=info
GRPC_ADDR=

# Required Shutter Network contract addresses
# These must be updated with actual deployed contract addresses
KEYPER_SET_MANAGER_ADDRESS=0x1234567890123456789012345678901234567890
KEY_BROADCAST_ADDRESS=0x1234567890123456789012345678901234567890

# Example addresses for different networks:
# KEYPER_SET_MANAGER_ADDRESS=0x...
# KEY_BROADCAST_ADDRESS=0x...
