# PrimeV PoC Sequencer Docker Environment Configuration
# Copy this file to .env and update the values for your environment

# RPC server configuration
UPSTREAM_RPC_URL=https://0xrpc.io/hoodi
LOG_LEVEL=info
LOG_FMT=text

# Transaction Verifier configuration
VERIFICATION_INTERVAL=10s

# Required configuration - these must be set for production
BIDDER_NODE_ADDRESS=0x1234567890123456789012345678901234567890

# P2P configuration - these must be set for production
P2P_KEY=your_p2p_private_key_here

# Bidder configuration
DOMAIN=testnet.mev-commit.xyz
SETTLEMENT_RPC_URL=https://chainrpc.testnet.mev-commit.xyz/
